{
  "name": "cambridge-pet-flashcards",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite build && vite preview",
    "build": "vite build",
    "preview": "vite preview",
    "audio:generate": "node scripts/generate-audio.mjs",
    "images:generate": "node scripts/generate-ket-storybook-clues.mjs",
    "data:extract": "python3 scripts/extract-pet-2025.py 'source/PET vocabulary list 2025.pdf' src/data/pet-2025-official-full.json && python3 scripts/filter-pet-only.py",
    "data:build": "python3 scripts/build-pet-course.py",
    "data:review": "python3 scripts/review-pet-content.py",
    "data:audit": "python3 scripts/audit-pet-content.py && python3 scripts/apply-editorial-overrides.py",
    "data:verify": "node scripts/verify-data.mjs",
    "test": "node scripts/verify-data.mjs && node scripts/verify-ui.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "openmoji": "^17.0.0",
    "serve": "^14.2.6",
    "sharp": "^0.34.3",
    "vite": "^7.0.5"
  }
}
